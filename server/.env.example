# Required: shared password your team uses to sign in
INBOX_PASSWORD=
# Required: random string that signs sign-in sessions (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

PORT=3000
DATABASE_PATH=./data/whatsapp.db
# Public https address of this app, if your host doesn't provide it (Render and Railway do)
PUBLIC_URL=

# Optional: WhatsApp details. Easier to enter them on the Connect WhatsApp page after signing in.
WHATSAPP_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WEBHOOK_VERIFY_TOKEN=

GRAPH_API_VERSION=v23.0
# Only change this to point at a mock server for local testing
GRAPH_API_BASE=https://graph.facebook.com
